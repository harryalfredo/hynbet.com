# HYNBET AI Clip Studio — server configuration
# Copy to .env and fill in values. Never put secrets in frontend code.

NODE_ENV=development
PORT=8787
HOST=0.0.0.0
DEV_MODE=true
ALLOW_LOCAL_SAMPLE=true

# SQLite file by default. Set a Postgres URL to switch later.
DATABASE_URL=sqlite:///home/user/data/hynbet.db

# BullMQ / Railway Redis — leave empty locally if Redis is not running.
# Production: set REDIS_URL from the Railway Redis service (redis:// or rediss://).
REDIS_URL=
WORKER_CONCURRENCY=1
HYNBET_RUN_WORKER=0
JOB_MAX_RETRIES=3
JOB_RETENTION_SEC=86400
JOB_CREATE_LIMIT_PER_MIN=8
JOB_BACKOFF_MS=4000

# Media tools
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Limits
MAX_VIDEO_DURATION=14400
MAX_UPLOAD_SIZE=2147483648
MAX_CLIPS_PER_PROJECT=10
MAX_CONCURRENT_JOBS_PER_USER=2
JOB_MAX_RETRIES=3

# Paths
DATA_DIR=/home/user/data
STORAGE_DIR=/home/user/data/storage
TMP_DIR=/home/user/data/tmp
DEV_SAMPLE_PATH=/home/user/data/samples/dev-conversation.mp4

# Object storage (optional — local disk is used when unset)
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_PUBLIC_URL=

# Official Kick Public API (https://docs.kick.com)
# App access tokens can read public channel/livestream metadata.
# Kick does not currently expose VOD media bytes on the public API.
# Media must come from an authorized source you control (upload, local file, or signed media URL).
# Public OAuth redirect (not a secret). Must match the Kick developer app.
KICK_REDIRECT_URI=https://hynbetcom-production-56c5.up.railway.app/api/auth/kick/callback

# KICK_CLIENT_ID may be set here (server-only). Do not put it in React / VITE_ vars.
KICK_CLIENT_ID=

# NEVER put KICK_CLIENT_SECRET in this workspace. Arena snapshots /home/user.
# Inject it as a process environment variable, or:
# HYNBET_SECRETS_FILE=/run/hynbet/secrets.env
# The server refuses to read KICK_CLIENT_SECRET from /home/user/.env
# KICK_CLIENT_SECRET=

KICK_API_BASE=https://api.kick.com
KICK_ID_BASE=https://id.kick.com

# Optional: user-provided authorized media for a Kick project (owner export, etc.)
# KICK_AUTHORIZED_MEDIA_URL=

# Speech-to-text + LLM (OpenAI-compatible)
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1
AI_TRANSCRIBE_MODEL=whisper-1
AI_CHAT_MODEL=gpt-4o-mini

# Session
SESSION_SECRET=change-me-in-production
SESSION_TTL_DAYS=14
